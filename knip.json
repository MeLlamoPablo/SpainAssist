{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "marketing/launch-video/render.mjs",
        "marketing/launch-video/scene.js",
        "tools/scan-eval/run.mjs"
      ],
      "project": ["scripts/**", "tools/scan-eval/**", "marketing/**/*.{js,mjs}"],
      "ignoreBinaries": ["ffmpeg"]
    },
    "apps/desktop": {
      "entry": [
        "src/main/dev/*.ts",
        "packaging/render-icon.mjs",
        "scripts/*.{ts,mjs}",
        "electron-builder.ts"
      ],
      "ignoreDependencies": ["typebox", "@napi-rs/canvas"],
      "ignoreBinaries": ["plutil", "go", "reg.exe", "explorer.exe"]
    },
    "apps/mock-sede": {
      "entry": ["public/js/*.js"]
    },
    "packages/agent": {
      "entry": [
        "src/host/main.ts",
        "scripts/*.mjs",
        "test/fixtures/make-pdf-fixture.ts",
        "test/helpers/hook-host.ts"
      ]
    },
    "e2e": {
      "ignoreDependencies": ["electron"]
    },
    "tools/eval": {
      "entry": [
        "src/host/eval-main.ts",
        "test/bench/harness-child.ts",
        "test/cli/helpers/slow-run.ts",
        "test/host/probe-host.ts",
        "test/llm/helpers/lock-child.ts",
        "test/llm/helpers/refresh-child.ts",
        "test/net/helpers/loopback-fetch-child.mts"
      ],
      "ignoreDependencies": ["typebox"],
      "ignoreBinaries": ["pgrep", "wget", "WGET.exe"]
    },
    "packages/browser": {
      "ignoreBinaries": ["pgrep"]
    },
    "packages/sidecar": {
      "ignoreBinaries": ["go"]
    },
    "services/relay-server": {
      "ignoreBinaries": ["openssl"],
      "ignoreUnresolved": ["./gradlew"]
    }
  }
}
