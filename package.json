{
  "name": "spain-assist",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @sa/desktop dev",
    "playground": "corepack pnpm --filter @sa/desktop preview:web --open '/?playground=1'",
    "dev:local": "SA_FEATURE_FLAGS=feedback-server,dnie-phone SA_KEY_SERVER_URL=http://127.0.0.1:8787 SA_FEEDBACK_SERVER_URL=http://127.0.0.1:8788 SA_MAPS_SERVER_URL=http://127.0.0.1:8793 SA_RELAY_SERVER_URL=http://127.0.0.1:8794 corepack pnpm --filter @sa/desktop dev",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm --workspace-concurrency=1 -r --if-present test",
    "e2e": "corepack pnpm --filter @sa/e2e e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "services": "node scripts/dev-services.mjs",
    "vouchers": "corepack pnpm --filter @sa/key-server vouchers:admin",
    "feedback": "corepack pnpm --filter @sa/feedback-server admin",
    "reset:dev": "corepack pnpm --filter @sa/desktop reset:dev",
    "reset:dev:onboarding": "corepack pnpm --filter @sa/desktop reset:dev:onboarding",
    "design:colors": "node tools/design-colors.mjs",
    "design:colors:check": "node tools/design-colors.mjs --check",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.0.0",
    "knip": "^6.41.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
