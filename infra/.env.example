# Copy to infra/.env (git-ignored): docker compose reads it automatically.
# Generate secrets with:  openssl rand -hex 32
# Keep passwords URL-safe (letters and digits): they are embedded in DATABASE_URL.

# --- Network -------------------------------------------------------------------------------
# Interface the service ports are published on. 127.0.0.1 = this machine only. This stack has
# no TLS: production runs on Coolify (infra/terraform).
BIND_ADDRESS=127.0.0.1

# --- Postgres (passwords are applied when the data volume is first created) -----------------
POSTGRES_PASSWORD=change-me-postgres
KEY_SERVER_DB_PASSWORD=change-me-key-server
FEEDBACK_DB_PASSWORD=change-me-feedback

# --- Key server ----------------------------------------------------------------------------
# REQUIRED. Secret used to HMAC voucher codes. Never change it once vouchers exist
# (every existing code would stop working).
VOUCHER_PEPPER=
# Enables the admin API (/admin/*). At least 16 characters. Empty = admin API disabled.
ADMIN_TOKEN=
# LiteLLM gateway that issues the capped keys (production runs it on Coolify, see
# infra/terraform). Empty LITELLM_ADMIN_URL = mock keys for the local mock LLM.
LITELLM_ADMIN_URL=
LITELLM_MASTER_KEY=
# URL handed to clients (they get <url>/v1). Empty = LITELLM_ADMIN_URL.
LITELLM_PUBLIC_URL=
# Comma-separated allowlists for issued keys. Empty = every model / search tool on the proxy.
LITELLM_KEY_MODELS=
LITELLM_SEARCH_TOOLS=
# Lifetime of voucher keys in days (0 = no expiry).
KEY_TTL_DAYS=180
# Per-IP rate limiting (1 = on).
RATE_LIMIT=1
# Development only: public demo voucher SA-DEMO-DEMO-DEMO (ignored when LiteLLM is configured).
DEV_SEED=0
MOCK_LLM_BASE_URL=http://127.0.0.1:8789/v1
LOG_LEVEL=info
