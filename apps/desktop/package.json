{
  "name": "@sa/desktop",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "SpainAssist desktop app (Electron + React)",
  "author": "Spain Assist",
  "homepage": "https://github.com/MeLlamoPablo/SpainAssist",
  "main": "./out/main/index.js",
  "scripts": {
    "build:agent": "corepack pnpm --filter @sa/agent build",
    "dev": "corepack pnpm --filter @sa/sidecar build && corepack pnpm build:agent && install-electron && node scripts/run-electron-vite.mjs dev",
    "build": "corepack pnpm --filter @sa/sidecar build && corepack pnpm build:agent && electron-vite build",
    "preview": "corepack pnpm --filter @sa/sidecar build && install-electron && node scripts/run-electron-vite.mjs preview",
    "preview:web": "vite --config vite.renderer.config.ts",
    "build:web": "vite build --config vite.renderer.config.ts",
    "serve:web": "vite preview --config vite.renderer.config.ts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "test:main": "vitest run --config vitest.main.config.ts",
    "notices": "node scripts/notices.ts",
    "check:secrets": "node scripts/secrets.ts",
    "captures": "node scripts/captures.ts",
    "package": "corepack pnpm build && node scripts/package.mjs --publish never",
    "package:dir": "corepack pnpm build && node scripts/package.mjs --dir --publish never",
    "package:mac": "corepack pnpm build && node scripts/package.mjs --mac --publish never",
    "package:win": "corepack pnpm build && node scripts/package.mjs --win --x64 --publish never",
    "package:linux": "corepack pnpm build && node scripts/package.mjs --linux --x64 --publish never",
    "smoke": "corepack pnpm --filter @sa/sidecar build && install-electron && node scripts/smoke.mjs",
    "reset:dev": "install-electron && node scripts/reset-dev.mjs",
    "reset:dev:onboarding": "install-electron && node scripts/reset-dev.mjs src/main/dev/resetOnboarding.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@napi-rs/canvas": "^1.0.10",
    "electron-updater": "^6.8.9",
    "playwright-core": "1.63.0",
    "typebox": "1.3.27",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sa/agent": "workspace:*",
    "@sa/browser": "workspace:*",
    "@sa/companion": "workspace:*",
    "@sa/mock-sede": "workspace:*",
    "@sa/pii": "workspace:*",
    "@sa/shared": "workspace:*",
    "@sa/sidecar": "workspace:*",
    "@sa/signer": "workspace:*",
    "@sa/vault": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.50.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
