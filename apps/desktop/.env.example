# Copy to apps/desktop/.env (gitignored). Read by dev builds only; variables already set in the
# environment win.

# Optional OpenRouter key for document presence/legibility checks (scan frame screening).
# Without it, scans are screened on our LiteLLM gateway with the voucher key or the ChatGPT
# account's key from the key server. Set it to screen with your own key in development.
# Kept in main only.
OPENROUTER_DECIDER_API_KEY=

# Service endpoints are built in (PRODUCTION_SERVICES in @sa/shared); they are not settings.
# Development builds only: point the app at the local services (`corepack pnpm services`) with
# http://127.0.0.1:8787, http://127.0.0.1:8788 and http://127.0.0.1:8793 here, or run
# `corepack pnpm dev:local`. Packaged builds ignore these.
SA_KEY_SERVER_URL=
SA_FEEDBACK_SERVER_URL=
SA_MAPS_SERVER_URL=
